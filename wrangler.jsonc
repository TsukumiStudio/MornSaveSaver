{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morn-save-saver",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "vars": { "ACCESS_AUD": "ae0b3171e87813200a6c705f61c4fd7429f71d6b5b3df2fd6cadb587711711ed" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "morn-save-saver", "database_id": "b3fb10b8-e6d5-4a87-b9bc-b07775bf0ea8", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "REGISTER_LIMIT", "namespace_id": "9123401", "simple": { "limit": 30, "period": 60 } },
    { "name": "SAVE_LIMIT", "namespace_id": "9123402", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "9123403", "simple": { "limit": 30, "period": 60 } }
  ]
}
