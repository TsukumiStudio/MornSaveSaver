{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "morn-save-saver-assets-probe",
  "main": "../fixtures/assets-probe.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
